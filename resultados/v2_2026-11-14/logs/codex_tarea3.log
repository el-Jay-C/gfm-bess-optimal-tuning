"""Cliente del oráculo de simulación en Julia (julia/servidor.jl) por stdin/stdout."""
import os
import queue
import subprocess
import threading
from pathlib import Path

import numpy as np

from .datos import RAIZ


class OraculoJulia:
    """Evalúa θ con un pool de procesos Julia. Uso: `with OraculoJulia() as o: m, g = o.evaluar(θ, 0)`."""

    def __init__(self, n_workers=None):
        if n_workers is None:
            n_workers = int(os.environ.get("GFM_WORKERS", "1"))
        if n_workers <= 0:
            n_workers = max(1, (os.cpu_count() or 2) // 2)
        self.n_workers = n_workers
        script = str(Path("julia") / "servidor.jl")
        self.procs = [subprocess.Popen(["julia", "--project=julia", script], cwd=RAIZ, text=True,
                                       stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                      for _ in range(n_workers)]
        self._pool = queue.Queue()
        self._lock = threading.Lock()
        for proc in self.procs:
            linea = proc.stdout.readline()
            while not linea.startswith("LISTO"):
                if not linea:
                    self.cerrar()
                    raise RuntimeError("El servidor de Julia terminó antes de estar listo")
                linea = proc.stdout.readline()
            m, g = linea[len("LISTO"):].split("|")
            self.nombres_m, self.nombres_g = m.split(), g.split()
            self._pool.put(proc)
        self.ig = {n: i for i, n in enumerate(self.nombres_g)}
        self.cache, self.n_eval = {}, 0

    def _pedir(self, proc, texto):
        proc.stdin.write(texto + "\n")
        proc.stdin.flush()
        return proc.stdout.readline()

    def evaluar(self, th, esc=0, lim=1):
        """Devuelve (métricas: dict, g: ndarray) para θ en el escenario esc (índice desde 0).
        lim = 1 simula con el limitador de sobrecarga; lim = 0, sin él."""
        clave = (esc, lim, *np.round(np.asarray(th, float), 12))
        with self._lock:
            if clave in self.cache:
                return self.cache[clave]
        proc = self._pool.get()
        try:
            linea = self._pedir(proc, f"EVAL {esc + 1} {lim} " + " ".join(f"{v:.12g}" for v in th))
        finally:
            self._pool.put(proc)
        v = np.array(linea.split(), float)
        nm = len(self.nombres_m)
        res = (dict(zip(self.nombres_m, v[:nm])), v[nm:])
        with self._lock:
            if clave not in self.cache:
                self.cache[clave] = res
                self.n_eval += 1
            return self.cache[clave]

    def nuevo(self, barra, dP, soc=(0.5, 0.5), pfv2=45.0):
        """Crea un escenario en todos los workers y devuelve su índice (desde 0)."""
        ocupados = [self._pool.get() for _ in range(self.n_workers)]
        try:
            idx = [int(self._pedir(proc, f"NUEVO {barra} {dP} {soc[0]} {soc[1]} {pfv2}")) - 1 for proc in ocupados]
        finally:
            for proc in ocupados:
                self._pool.put(proc)
        return idx[0]

    def cerrar(self):
        for proc in self.procs:
            if proc.poll() is None:
                try:
                    proc.stdin.write("SALIR\n")
                    proc.stdin.flush()
                    proc.wait(timeout=30)
                except Exception:
                    proc.kill()

    def __enter__(self):
        return self

    def __exit__(self, *_):
        self.cerrar()
# Verifica que el modelo CasADi y el de Julia producen las mismas trayectorias, con y sin el limitador
# de sobrecarga activo, y que la simulación de caja negra y el oráculo entregan las mismas métricas.
import sys

import numpy as np

sys.path.insert(0, str(__import__("pathlib").Path(__file__).parent))
from gfm import datos, modelo
from gfm.oraculo import OraculoJulia

p, c, esc = datos.cargar()
t = datos.malla(p)
dt = np.diff(t)
wtrap = np.concatenate([[dt[0] / 2], (dt[:-1] + dt[1:]) / 2, [dt[-1] / 2]])
casos = {"inicial": np.array(p["optimizacion"]["theta_inicial"], float),
         "limitador activo": np.array([8.0, 8.0, 50.0, 50.0, 20.0, 20.0, 1.0, 1.0])}
with OraculoJulia() as orac:
    for nombre, th in casos.items():
        for k, e in enumerate(esc):
            f, sal = modelo.construir(c, e)
            X = modelo.simular(f, e["x0"], th, t)
            Y = np.asarray(sal.map(X.shape[1])(X, th))
            m, g = orac.evaluar(th, k, 1)
            F = Y[[modelo.IDX[n] for n in ("f_sg", "f1", "f2")]]
            py = {"dfmax_Hz": np.max(np.abs(F - c["f0"])),
                  "I2_pico": np.sqrt(Y[modelo.IDX["I2sq"]].max()),
                  "I2_fin": np.sqrt(Y[modelo.IDX["I2sq"], -1]),
                  "th2_frac": Y[modelo.IDX["th2"]].max() / c["B"],
                  "pred1_max": Y[modelo.IDX["pred1"]].max(),
                  "pred2_max": Y[modelo.IDX["pred2"]].max(),
                  "perdidas": (Y[modelo.IDX["ploss"]] - c["ploss0"]) @ wtrap / (t[-1] * e["dP"])}
            err = {q: abs(v - m[q]) / max(abs(m[q]), 1e-3) for q, v in py.items()}
            peor = max(err, key=err.get)
            print(f"{nombre:17s} {e['nombre']:12s} error relativo máximo = {err[peor]:.1e} ({peor}); "
                  f"pred máx = {m['pred1_max']:.3f}/{m['pred2_max']:.3f}")
            assert err[peor] < 2e-4, f"Modelos inconsistentes en {peor}: {py[peor]} vs {m[peor]}"
print("Modelos Julia y CasADi consistentes.")
