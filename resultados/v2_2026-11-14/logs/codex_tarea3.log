    k5 = findfirst(>=(5.0), t)
    fsg = [r.f_sg for r in y]
    kmax = k5 - 1 + argmax(fsg[k5:end])
    seg = fsg[kmax] - minimum(fsg[kmax:end])
    lin_lp[idx] = cs([x.nombre, e.nombre, y[findfirst(>=(30.0), t)].f_sg, y[end].f_sg, y[end].I1, y[end].I2,
                      y[end].pb1, y[end].pb2, maximum(r.th1 for r in y) / s.B, maximum(r.th2 for r in y) / s.B,
                      maximum(r.pred1 for r in y), maximum(r.pred2 for r in y), kl === nothing ? NaN : t[kl],
                      y[end].E1, y[end].E2, m30[im("E1_serv_MWs")], m30[im("E2_serv_MWs")],
                      s.f0 - fm[kmin], t[kmin], seg])
end
open(joinpath(dir, "largo_plazo.csv"), "w") do io
    println(io, cs(["sintonia", "escenario", "f_30", "f_Ts", "I1_Ts", "I2_Ts", "pb1_Ts", "pb2_Ts", "th1_frac", "th2_frac",
                    "pred1_max", "pred2_max", "t_limitador_s", "E1_Ts_real", "E2_Ts_real", "E1_extrapolada",
                    "E2_extrapolada", "dfmax", "t_fmin", "df_segundo_descenso"]))
    foreach(l -> println(io, l), lin_lp)
end

# ---------------------------------------------------------------- trayectorias (S1)
e_tr = s.esc[1]
t_tr = collect(0:0.02:60)
pares_tr = [(x, lim) for x in sint for lim in (0.0, 1.0)]
res_tr = Vector{Any}(undef, length(pares_tr))
Threads.@threads for idx in eachindex(pares_tr)
    x, lim = pares_tr[idx]
    t, X = simular(s, merge(e_tr, (lim=lim,)), θ_de(x, e_tr); t=t_tr)
    res_tr[idx] = (x.nombre, Int(lim), salidas(s, e_tr, t, X))
end
open(joinpath(dir, "trayectorias.csv"), "w") do io
    cabt = false
    for (nom, lim_i, ys) in res_tr, r in ys
        cabt || (println(io, cs(["sintonia", "lim", string.(keys(r))...])); cabt = true)
        println(io, cs([nom, lim_i, values(r)...]))
    end
end

# ---------------------------------------------------------------- fuera de muestra
rng = MersenneTwister(2026)
N = 500
muestras = [Dict("nombre" => "m$k", "barra" => rand(rng, 2:5), "dP" => 20 + 30 * rand(rng),
                 "SOC0" => 0.2 .+ 0.6 .* rand(rng, 2), "P_fv2" => 35 + 10 * rand(rng)) for k in 1:N]
escs_m = [s.nuevo_esc(d) for d in muestras]
pares_fm = [(k, j) for k in 1:N for j in eachindex(sint)]
lin_fm = Vector{String}(undef, length(pares_fm))
i_pred1, i_pred2 = im("pred1_max"), im("pred2_max")
Threads.@threads for idx in eachindex(pares_fm)
    k, j = pares_fm[idx]
    d, e, x = muestras[k], escs_m[k], sint[j]
    θ = θ_de(x, e)
    m, g = evaluar(s, sin_limitador(e), θ)
    ml, _ = evaluar(s, e, θ)
    lin_fm[idx] = cs([x.nombre, d["nombre"], d["barra"], d["dP"], d["SOC0"]..., d["P_fv2"], m[1], m[2],
                      max(0.0, maximum(g)), NOMBRES_G[argmax(g)], maximum(g) <= TOL, ml[1], ml[2],
                      max(ml[i_pred1], ml[i_pred2])])
end
open(joinpath(dir, "fuera_muestra.csv"), "w") do io
    println(io, cs(["sintonia", "muestra", "barra", "dP", "SOC1", "SOC2", "P_fv2", "J", "dfmax_Hz", "max_violacion",
                    "restriccion_peor", "factible", "J_lim", "dfmax_lim", "pred_max"]))
    foreach(l -> println(io, l), lin_fm)
end

# ---------------------------------------------------------------- escalón de consigna de tensión (1 %)
e_esc = merge(s.esc[1], (Yred=s.esc[1].Yred_pre, W=s.esc[1].W_pre))        # red previa al evento (equilibrio)
t_esc = collect(0:0.001:10)
pares_esc = [(x, i) for x in sint for i in 1:2]
lin_esc = Vector{String}(undef, length(pares_esc))
Threads.@threads for idx in eachindex(pares_esc)
    x, i = pares_esc[idx]
    U0 = copy(s.U0); U0[i] *= 1.01
    _, X = simular(merge(s, (U0=U0,)), e_esc, x.θ; t=t_esc)
    y = salidas(s, e_esc, t_esc, X)
    u = [i == 1 ? r.U1 : r.U2 for r in y]
    Δ = u .- u[1]
    fin = Δ[end]
    cruce(f) = t_esc[findfirst(k -> Δ[k] / fin >= f, eachindex(t_esc))]
    fuera = findlast(k -> abs(Δ[k] / fin - 1) > 0.05, eachindex(t_esc))
    lin_esc[idx] = cs([x.nombre, i, cruce(0.1), cruce(0.9) - cruce(0.1), fuera === nothing ? 0.0 : t_esc[min(fuera + 1, end)],
                       100 * (maximum(Δ ./ fin) - 1)])
end
open(joinpath(dir, "escalon_tension.csv"), "w") do io
    println(io, cs(["sintonia", "gfm", "t_reaccion_s", "t_crecimiento_s", "t_establecimiento_s", "sobreoscilacion_pct"]))
    foreach(l -> println(io, l), lin_esc)
end
println("Validación escrita en ", dir)
"""Certificado de estabilidad de pequeña señal por SDP (LMI de Lyapunov).

Alcance: estabilidad local (pequeña señal) del equilibrio post-perturbación del subsistema AC. No certifica la
trayectoria completa ni la región de atracción. Para una sola matriz A el SDP reproduce lo que entregan los
autovalores; su aporte propio es la función de Lyapunov común a varios escenarios (tasa_certificada_comun).

Se linealiza el subsistema AC (SG + lazos P-f y Q-V de los GFM, ángulos relativos a la máquina) en el
equilibrio post-perturbación, ż = A z. Para una tasa de decaimiento α se busca P tal que
    P ⪰ I,   AᵀP + PA + 2αP ⪯ 0,
que es una LMI (SDP) en P. El mayor α factible se obtiene por bisección (problema cuasiconvexo) y
certifica que todas las trayectorias linealizadas decaen al menos como e^{-αt}. Además, con la región
LMI cónica de Chilali y Gahinet (1996) se certifica un amortiguamiento mínimo ζ de todos los modos:
    X ≻ 0,  [[sinϑ(AX+XAᵀ), cosϑ(AX−XAᵀ)], [cosϑ(XAᵀ−AX), sinϑ(AX+XAᵀ)]] ≺ 0,  ζ = cos ϑ.
Los estados del BESS (SOC, vrc, e) no realimentan la dinámica AC y se excluyen.
"""
import casadi as ca
import cvxpy as cp
import numpy as np

from .modelo import NX, construir, igfm, simular

AC = [1, 2, 3] + [igfm(i) + k for i in range(2) for k in (0, 1, 2, 3)]   # ωg, xg, xr, δi, ωi, Ei, qmi


def linealizar(c, e, th, T_eq=60.0):
    """Matriz A del subsistema AC en el equilibrio post-perturbación (ángulos relativos a δg)."""
    f, _ = construir(c, e)
    X = simular(f, e["x0"], th, np.arange(0.0, T_eq + 0.05, 0.1))    # punto de partida cercano al equilibrio
    xb = X[:, -1].copy()
    z, wb = ca.SX.sym("z", len(AC)), c["wb"]

    def x_de(zz):
        x = ca.SX(xb)
        x[0] = 0
        for j, k in enumerate(AC):
            x[k] = zz[j]
        return x

    dx = f(x_de(z), th)
    dz = []
    for j, k in enumerate(AC):
        if k in (igfm(0), igfm(1)):                          # δi relativo: d(δi-δg)/dt = ωb(ωi - ωg)
            dz.append(wb * (z[j + 1] - z[0]))
        else:
            dz.append(dx[k])
    dz = ca.vertcat(*dz)
    z0 = xb[AC].copy()
    for j, k in enumerate(AC):
        if k in (igfm(0), igfm(1)):
            z0[j] = xb[k] - xb[0]
    raiz = ca.rootfinder("eq", "newton", ca.Function("F", [z], [dz]))
    zeq = np.asarray(raiz(z0)).ravel()
    A = np.asarray(ca.Function("J", [z], [ca.jacobian(dz, z)])(zeq))
    return A, np.max(np.abs(np.asarray(ca.Function("F", [z], [dz])(zeq))))


def _resolver(pr):
    """Clarabel (punto interior); si falla por mal condicionamiento cerca de la frontera, SCS."""
    for solver, opts in ((cp.CLARABEL, {}), (cp.SCS, {"eps": 1e-7, "max_iters": 50000})):
        try:
            pr.solve(solver=solver, **opts)
            if pr.status == cp.OPTIMAL:
                return True
        except cp.error.SolverError:
            continue
    return False


def lmi_factible(A, alpha):
    n = A.shape[0]
    P = cp.Variable((n, n), symmetric=True)
    M = A.T @ P + P @ A + 2 * alpha * P
    pr = cp.Problem(cp.Minimize(0), [P >> np.eye(n), (M + M.T) / 2 << 0])
    return _resolver(pr)


def _escalar(A):
    """Escalamiento diagonal (similaridad, no cambia los polos) para mejorar el condicionamiento del SDP."""
    s = np.sqrt(np.maximum(np.linalg.norm(A, axis=1) * np.linalg.norm(A, axis=0), 1e-12)) ** -0.5
    return np.diag(1 / s) @ A @ np.diag(s)


def sector_factible(A, zeta):
    n, th = A.shape[0], np.arccos(zeta)
    X = cp.Variable((n, n), symmetric=True)
    S1, S2 = A @ X + X @ A.T, A @ X - X @ A.T
    M = cp.bmat([[np.sin(th) * S1, np.cos(th) * S2], [-np.cos(th) * S2, np.sin(th) * S1]])
    pr = cp.Problem(cp.Minimize(0), [X >> np.eye(n), (M + M.T) / 2 << 0])
    return _resolver(pr)


def amortiguamiento_certificado(A, tol=1e-3):
    """Mayor ζ tal que todos los polos están en el sector cónico (bisección sobre la región LMI)."""
    As = _escalar(A)
    if not sector_factible(As, 1e-3):
        return -np.inf
    lo, hi = 1e-3, 0.999
    while hi - lo > tol:
        mid = (lo + hi) / 2
        lo, hi = (mid, hi) if sector_factible(As, mid) else (lo, mid)
    return lo


def tasa_certificada(A, tol=1e-3):
    """Mayor α con LMI factible (bisección). Devuelve -inf si no se certifica estabilidad."""
    As = _escalar(A)
    if not lmi_factible(As, 0.0):
        return -np.inf
    lo, hi = 0.0, max(1.0, -np.min(np.linalg.eigvals(A).real))
    while hi - lo > tol * max(1.0, lo):
        mid = (lo + hi) / 2
        lo, hi = (mid, hi) if lmi_factible(As, mid) else (lo, mid)
    return lo


def lmi_comun_factible(As, alpha):
    n = As[0].shape[0]
    P = cp.Variable((n, n), symmetric=True)
    res = [P >> np.eye(n)]
    for A in As:
        M = A.T @ P + P @ A + 2 * alpha * P
        res.append((M + M.T) / 2 << 0)
    return _resolver(cp.Problem(cp.Minimize(0), res))


def tasa_certificada_comun(As, tol=1e-3):
    """Mayor α con una única P ≻ 0 tal que AₛᵀP + PAₛ + 2αP ⪯ 0 para todas las matrices Aₛ (bisección).
    Es una función de Lyapunov cuadrática común: certifica la tasa α para cada escenario y para cualquier
    combinación convexa de ellos (incertidumbre politópica), algo que los autovalores por separado no entregan.
    Devuelve -inf si no existe."""
    A0 = As[0]
    s = np.sqrt(np.maximum(np.linalg.norm(A0, axis=1) * np.linalg.norm(A0, axis=0), 1e-12)) ** -0.5
    Ae = [np.diag(1 / s) @ A @ np.diag(s) for A in As]            # misma similaridad para todas
    if not lmi_comun_factible(Ae, 0.0):
        return -np.inf
    lo, hi = 0.0, min(-np.max(np.linalg.eigvals(A).real) for A in As)
    while hi - lo > tol * max(1.0, lo):
        mid = (lo + hi) / 2
        lo, hi = (mid, hi) if lmi_comun_factible(Ae, mid) else (lo, mid)
    return lo


if __name__ == "__main__":     # verificación: sistema con autovalores conocidos
    A = np.array([[-1.0, 10.0], [-10.0, -1.0]])             # λ = -1 ± 10j  →  α* = 1
    a = tasa_certificada(A)
    assert abs(a - 1.0) < 1e-2, a
    assert tasa_certificada(np.array([[0.5, 0.0], [0.0, -1.0]])) == -np.inf
    z = amortiguamiento_certificado(A)                       # ζ = 1/√101 ≈ 0,0995
    assert abs(z - 1 / np.sqrt(101)) < 2e-3, z
    B = np.array([[-2.0, 5.0], [-5.0, -2.0]])                # λ = -2 ± 5j
    ac = tasa_certificada_comun([A, B])
    assert 0.5 < ac <= 1.0 + 1e-2, ac                        # no puede superar la tasa del más lento
    print("Certificado LMI OK, α* =", a, " α común =", ac)
#!/usr/bin/env bash
# Ejecuta todos los experimentos del informe (desde Codigos_final/). Uso: ./ejecutar_todo.sh (o PY=... JOBS=... ./ejecutar_todo.sh)
# Autodetecta Python (rutas relativas) y núcleos del sistema; cada experimento guarda sus CSV y `conv` se reanuda solo.
cd "$(dirname "$0")"
if [ -z "${PY:-}" ]; then
  for cand in ../Codigos/.venv/bin/python .venv/bin/python ../.venv/bin/python ../Codigos/.venv/Scripts/python.exe .venv/Scripts/python.exe; do
    if [ -x "$cand" ]; then PY="$cand"; break; fi
  done
  PY="${PY:-$(command -v python3 || command -v python)}"
fi
NPROC="$("$PY" -c "import os; print(os.cpu_count() or 4)")"
JOBS="${JOBS:-$(( NPROC > 2 ? NPROC / 2 : 1 ))}"
[ "$JOBS" -lt 1 ] && JOBS=1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 JULIA_NUM_THREADS=1   # un hilo por proceso en paralelo: tiempos comparables
mkdir -p resultados/logs
correr() { "$PY" python/ejecutar_experimentos.py $1 > "resultados/logs/$(echo $1 | tr -d ' -' ).log" 2>&1; }
export -f correr; export PY
printf '%s\n' "conv --metodo F4 --n 20 --workers 1" "conv --metodo F3 --n 20 --workers 1" \
  "conv --metodo F5 --n 10 --workers 1" "conv --metodo F1 --n 10 --workers 1" \
  "conv --metodo F2 --n 20 --workers 1" "conv --metodo F4b --n 4 --workers 1" \
  "modos --n 6 --workers 1" "ablacion --n 6 --workers 1" "pesos --n 6 --workers 1" \
  "barridos --n 3 --workers 1" "robusto --n 6 --workers 1" | xargs -P "$JOBS" -I{} bash -c 'correr "{}"'
correr "malla"
correr "optimos"
correr "cert"
julia --threads=auto --project=julia julia/validar.jl > resultados/logs/validar.log 2>&1
date > resultados/logs/TERMINADO
# Parámetros únicos del caso de estudio (los leen Julia y Python).
# Unidades: indicadas en cada línea. "pu" sin más = base propia del equipo.
# Referencias normativas: NTSyCS 2026 (Res. Ex. CNE N°45) y su Anexo Técnico IBR (AT-IBR).

[sistema]
f0 = 50.0          # Hz, frecuencia nominal (NTSyCS)
Sb = 100.0         # MVA, base del sistema
Vb = 230.0         # kV, base de tensión de la fuente del sistema de 5 barras (ST 200-500 kV)

# Líneas: datos de secuencia positiva por km (Tabla I del informe; Kumari et al. 2021,
# basados en Bhandakkar y Mathew 2017, sistema de 5 barras de Stagg y El-Abiad).
# [desde, hasta, largo_km, R_ohm_km, L_H_km, C_F_km]
[red]
lineas = [
  [1, 2, 47.0, 0.22, 0.0017, 6.3e-9],
  [1, 3, 87.0, 0.48, 0.0038, 2.87e-9],
  [2, 3, 67.0, 0.46, 0.0037, 2.97e-9],
  [2, 4, 67.0, 0.46, 0.0037, 2.97e-9],
  [2, 5, 47.0, 0.44, 0.0035, 3.15e-9],
  [3, 4, 19.0, 0.27, 0.0021, 5.14e-9],
  [4, 5, 87.0, 0.48, 0.0038, 2.87e-9],
]
# Consumos por barra (MW, Mvar) del sistema de Stagg y El-Abiad, modelados como impedancia constante.
carga_P = [0.0, 20.0, 45.0, 40.0, 60.0]
carga_Q = [0.0, 10.0, 15.0, 5.0, 10.0]
V_slack = 1.04     # pu, barra 1 (máquina síncrona). Consignas escalonadas (1,04 / 1,025 / 1,015) para que la
                   # potencia reactiva se reparta entre las tres fuentes sin circulación entre ellas.

[sg]               # Máquina síncrona térmica equivalente en barra 1 (modelo clásico + gobernador con recalentador)
barra = 1
S = 120.0          # MVA
H = 3.5            # s
xd_p = 0.25        # pu, reactancia transitoria
D = 1.0            # pu, amortiguamiento mecánico
R = 0.05           # pu, estatismo 5 % (NTSyCS Art. 3-13: 4-8 % unidades sincrónicas no hidráulicas)
TG = 0.2           # s, gobernador
TR = 7.0           # s, recalentador
FH = 0.3           # fracción de potencia de la turbina de alta presión

[gfm]              # Dos inversores GFM (VSG) con BESS. Índice 1 = barra 2 (BESS), 2 = barra 3 (FV + BESS)
nombres = ["GFM1", "GFM2"]
barra = [2, 3]
S = [60.0, 60.0]           # MVA, potencia aparente del inversor
P0 = [40.0, 45.0]          # MW, consigna (GFM1 = generador de 40 MW de la barra 2 de la fuente)
V0 = [1.025, 1.015]        # pu, consigna de tensión (barra PV en el flujo de potencia)
P_fv = [0.0, 45.0]         # MW, generación FV en MPPT (constante durante el evento)
Xf = [0.15, 0.15]          # pu, reactancia de acoplamiento (filtro + transformador)
tau_q = [0.02, 0.02]       # s, filtro de medición de Q
R_conv = [0.01, 0.01]      # pu, pérdidas del convertidor  p_loss = R_conv |i|^2
# Capacidad de sobrecorriente (AT-IBR Art. 3-1 d): por diseño, al menos 1,3 pu durante 5 s. Es una capacidad
# mínima de diseño. La generalizamos (supuesto de modelamiento) como un presupuesto térmico I²t:
#   dϑ/dt = max(i² - I_cont², 0),  B = (I_max² - I_cont²)·t_sobrecorriente,
# de modo que 1,3 pu se sostiene 5 s y una sobrecarga menor se sostiene proporcionalmente más tiempo.
I_max = 1.3                # pu, corriente máxima (límite del equipo)
I_cont = 1.0               # pu, corriente nominal permanente
t_sobrecorriente = 5.0     # s, duración de I_max que fija el presupuesto térmico
# Limitador de sobrecarga: un lazo integral reduce la consigna de potencia del VSG mientras la corriente supere
# el límite vigente (I_max con presupuesto térmico disponible, I_cont al agotarse) o el BESS supere su potencia
# nominal. La corriente del banco admite i_max [bess] de forma transitoria.
k_lim = 2.0                # 1/s, ganancia integral del limitador (pu de potencia por pu de corriente y segundo)
tau_lib = 2.0              # s, liberación de la reducción de consigna cuando la corriente vuelve bajo el límite
eps_i = 0.01               # pu, ancho de suavizado de la corriente
eps_th = 0.005             # pu², ancho de suavizado del integrando térmico
margen_th = 1.0            # el límite pasa de I_max a I_cont en torno a ϑ = margen_th·B (mismo presupuesto que ϑ ≤ B)
ancho_th = 0.02            # fracción de B en que el límite pasa de I_max a I_cont
n_sep = 5.0                # separación de escalas: el lazo Q-V debe ser n_sep veces más lento que el filtro tau_q

[bess]             # Modelo Thevenin de 1er orden por unidad en base propia del BESS
P_nom = [60.0, 20.0]       # MW
E_h = [1.0, 1.0]           # h de autonomía a potencia nominal
SOC0 = [0.5, 0.5]
SOC_min = 0.1
SOC_max = 0.9
ocv0 = 0.9                 # pu, OCV(SOC) = ocv0 + ocv1*SOC
ocv1 = 0.2
R0 = 0.03                  # pu, resistencia óhmica
R1 = 0.02                  # pu, rama RC (polarización)
tau1 = 20.0                # s, constante de tiempo R1*C1
eta_c = 0.97               # eficiencia coulómbica de carga
i_max = 1.2                # pu, corriente máxima del banco (C-rate)
v_min = 0.85               # pu, tensión mínima en bornes del banco
reserva = 0.05             # fracción de la energía nominal reservada para el servicio de frecuencia
                           # (E_res = reserva·P_nom·E_h: 10 800 MWs y 3 600 MWs)
T_servicio = 300.0         # s, tiempo que debe sostenerse la respuesta primaria hasta el relevo del control
                           # secundario (supuesto de modelamiento)

[norma]            # Límites de desempeño
f_min_perm = 49.0          # Hz, operación permanente 49-51 Hz (NTSyCS Art. 3-10)
rocof_max = 2.0            # Hz/s, medido en ventana de 500 ms (NTSyCS Art. 3-10 c)
ventana_rocof = 0.5        # s
V_min_alerta = 0.93        # pu, ST 200-500 kV en estado de alerta (NTSyCS Art. 5-23)
V_max_alerta = 1.07
V_min_normal = 0.95        # pu, ST 200-500 kV en estado normal (NTSyCS Art. 5-19)
V_max_normal = 1.05
dP_diseno = 50.0           # MW, contingencia de diseño para el requisito de inercia
t_crec_tension = 1.0       # s, tiempo de crecimiento del controlador de tensión (AT-IBR Art. 3-3 e)

[optimizacion]
T = 30.0                   # s, horizonte de simulación (unas 4 constantes de tiempo del recalentador)
# Malla no uniforme: [instante final, paso]. Los pasos dividen la ventana de RoCoF (0,5 s).
malla = [[3.0, 0.025], [30.0, 0.05]]
# Variables por GFM: H [s], D [pu] (estatismo 2-5 %, AT-IBR Art. 3-6), Kq [pu] (estatismo de tensión 2-10 %, AT-IBR Art. 3-3), K [1/s]
H_lim = [0.5, 10.0]
D_lim = [20.0, 50.0]
Kq_lim = [10.0, 50.0]
K_lim = [0.05, 5.0]        # cota amplia: K queda limitada por R9 (rapidez mínima y separación de escalas)
theta_inicial = [3.0, 3.0, 25.0, 25.0, 20.0, 20.0, 1.0, 1.0]   # [H1 H2 D1 D2 Kq1 Kq2 K1 K2]
# Pesos del objetivo J = wf*nadir/df_ref + wv*desv_tension + wl*perdidas
wf = 1.0
wv = 1.0
