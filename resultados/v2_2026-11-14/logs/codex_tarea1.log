\end{table}

\textbf{Brecha y contribución.} Hasta donde se revisó, ningún trabajo sintoniza en forma conjunta ambos lazos
imponiendo en la trayectoria la capacidad de sobrecarga del inversor, la física del BESS y los requisitos de
inercia de la norma chilena. La contribución principal es una formulación de sintonía en que la sobrecarga
se trata de dos maneras comparables: con restricciones que impiden que el limitador actúe, o con el limitador
dentro de la dinámica. Las contribuciones secundarias son la comparación estadística de seis métodos de
solución sobre el mismo problema y una sintonía robusta con recurso mediante una regla de decisión afín.

\textbf{Preguntas de investigación} y criterio con que se responden.
P1) ¿Cuánto cambia la sintonía respecto del artículo base y qué restricción explica cada cambio? Se responde
agregando un grupo de restricciones a la vez.
P2) ¿Qué método llega al óptimo con mayor confiabilidad y rapidez? Se mide la fracción de 20 puntos iniciales
comunes que alcanza el mejor valor conocido y el tiempo que tarda.
P3) ¿Qué restricciones son activas y cuánto vale relajarlas? Se contrastan los multiplicadores con la pendiente
de un barrido.
P4) ¿Cuánto cuesta una sintonía única para varios puntos de operación y cuánto recupera una regla afín? Se
evalúa en escenarios que no se usaron al optimizar.

\section{Modelo matemático}

\subsection{Sistema de prueba y escenarios}
Se usa el sistema de 5 barras de Stagg y El-Abiad~\cite{Stagg1968} a 230~kV y 50~Hz, con los parámetros de
línea de~\cite{Kumari2021} y 165~MW de demanda (Fig.~\ref{fig:unilineal}). La barra~1 tiene una máquina
síncrona (SG) térmica de 120~MVA con gobernador y recalentador~\cite{Kundur1994}. La barra~2 tiene un BESS de
60~MW/60~MWh y la barra~3, una planta fotovoltaica (FV) de 45~MW con un BESS de 20~MW/20~MWh; ambos usan
inversores GFM de 60~MVA. Las consignas de tensión son 1,04, 1,025 y 1,015~pu, de modo que las tres fuentes
entregan potencia reactiva y los inversores parten con corrientes de 0,66 y 0,74~pu.

La perturbación es un escalón de carga de 50~MW, la misma contingencia que fija el requisito de inercia. S1 lo
aplica en la barra~5; S2, en la barra~4; y S3 repite S1 con 35~MW de FV disponible y un estado de carga de
20~\%, de modo que el BESS2 ya entrega 10~MW antes del evento. Las probabilidades son 0,5, 0,3 y 0,2.

\begin{figure}[t]
\centering
\resizebox{0.8\columnwidth}{!}{\input{figuras/diagrama_5barras}}
\caption{Sistema de prueba: una máquina síncrona y dos inversores GFM con BESS.}
\label{fig:unilineal}
\end{figure}

\subsection{Dinámica}
El modelo es fasorial (RMS), como el de~\cite{Wang2024}. Cada fuente es una fem detrás de una reactancia y las
cargas son impedancias constantes, por lo que la red se reduce por Kron a los nodos internos,
$\mb I=\mb Y_{red}\mb E$, y el escalón sólo modifica $\mb Y_{red}$. La SG sigue la ecuación de oscilación con
gobernador y recalentador~\cite{Kundur1994}. Cada GFM $i\in\{1,2\}$ sigue
\begin{subequations}\label{eq:vsg}
\begin{align}
&\dot\delta_i = \omega_b(\omega_i-1), \quad 2H_i\dot\omega_i = p_i^0 - \rho_i - p_i - D_i(\omega_i-1), \label{eq:vsg_w}\\
&\dot E_i = K_i\big[K_{q,i}(U_i^0-U_i) + q_i^0 - q_i^m\big], \quad \tau_q\dot q_i^m = q_i - q_i^m, \label{eq:vsg_e}
\end{align}
\end{subequations}
donde $\rho_i$ es la reducción de consigna que impone el limitador. El BESS es un circuito de Thevenin de
primer orden. Su potencia es $p_{b,i}=(p_i+R_ci_i^2-p_{fv,i})S_i/P^n_i$ y
\begin{subequations}\label{eq:bess}
\begin{align}
&i_{b,i}=\big(v_o-\sqrt{v_o^2-4R_0p_{b,i}}\big)/(2R_0), \quad v_o=\mathrm{OCV}(SOC_i)-v_{rc,i},\\
&\tau_1\dot v_{rc,i}=R_1i_{b,i}-v_{rc,i}, \quad \dot{SOC}_i=-i_{b,i}/(3600E_h),\\
&\dot e_i=(p_{b,i}-p^0_{b,i})P^n_i,
\end{align}
\end{subequations}
con $e_i$ la energía entregada sobre el punto previo.

\textbf{Limitador de sobrecarga.} El AT-IBR pide una capacidad mínima de 1,3~pu durante 5~s. Se generaliza
como un presupuesto térmico: $\vartheta_i$ acumula el exceso de $i^2$ sobre el valor nominal y el límite de
corriente vigente $\bar\imath_i$ baja de $I_{max}$ a $I_c$ cuando el presupuesto $B=(I_{max}^2-I_c^2)\cdot5$~s
$=3{,}45$~pu$^2$s se agota. Mientras la corriente supera $\bar\imath_i$, o el banco supera su potencia nominal,
un lazo integral reduce la consigna de potencia; la reducción se libera cuando ambos vuelven bajo su límite:
\begin{subequations}\label{eq:lim}
\begin{align}
\dot\vartheta_i &= \rp{i_i^2-I_c^2}, \qquad
\bar\imath_i = I_c + (I_{max}-I_c)\,\sigma\!\Big(\frac{B-\vartheta_i}{aB}\Big),\\
\dot\rho_i &= k_\ell\Big(\rp{i_i-\bar\imath_i}+\tfrac{P^n_i}{S_i}\rp{p_{b,i}-1}\Big)
 -\frac{\rho_i}{\tau_\ell}\,\sigma\!\Big(\frac{\bar\imath_i-i_i}{\varepsilon}\Big)\sigma\!\Big(\frac{1-p_{b,i}}{\varepsilon}\Big).
\end{align}
\end{subequations}
Aquí $\rp{x}=\max(x,0)+\varepsilon\ln(1+e^{-|x|/\varepsilon})$ y $\sigma$ es la sigmoide logística. Estas
funciones suaves evitan variables binarias o condiciones de complementariedad, y mantienen el modelo
diferenciable. Reducir la consigna de potencia ante saturación es una de las estrategias documentadas
en~\cite{Fan2022}; la forma I$^2$t del presupuesto es un supuesto propio. En compacto,
$\dot{\mb x}=f(\mb x,\theta)$ con 22 estados. El estado inicial es el equilibrio previo, que no depende de
$\theta$.

\subsection{Problema de optimización}
Las decisiones son $\theta=[H_1,H_2,D_1,D_2,K_{q,1},K_{q,2},K_1,K_2]$. El objetivo pondera la desviación
máxima de frecuencia, la desviación de tensión y el aumento de pérdidas:
\begin{align}
J ={}& w_f\,\frac{z_f}{\Delta f_{ref}} + \frac{w_v}{5T}\!\int_0^T\!\sum_b\!\Big(\frac{V_b-V_b^0}{\Delta V_{ref}}\Big)^2\!dt
+ \frac{w_l}{T\Delta P}\!\int_0^T\!(p_{loss}-p_{loss}^0)\,dt. \label{eq:obj}
\end{align}
La desviación máxima $\Delta f_{max}=\max_{u,t}|f_u(t)-f_0|$ no es diferenciable y se reemplaza por la variable
epígrafe $z_f$. El problema (P) es
\begin{align}
\min_{\theta,\,z_f}\;& J \quad \text{s.a.} \quad \dot{\mb{x}}=f(\mb{x},\theta),\;\mb{x}(0)=\mb{x}_0 \tag{R1}\\
& |f_u(t)-f_0| \le z_f \le 1\,\text{Hz},\;\; |f_u(t)-f_u(t-0{,}5)| \le 1\,\text{Hz} \tag{R2}\\
& i_i(t) \le I_{max},\;\; \vartheta_i(T)\le B,\;\; i_i(T)\le I_c \tag{R3}\\
& |i_{b,i}|\le 1{,}2,\; v_{b,i}\ge 0{,}85,\; |p_{b,i}|\le1,\; SOC_i\in[0{,}1;0{,}9] \tag{R4}\\
& e_i(T) + (T_s-T)\big(p_{b,i}(T)-p_{b,i}^0\big)P^n_i \le E_i^{res} \tag{R5}\\
& 0{,}93 \le V_b(t) \le 1{,}07 \tag{R6}\\
& \textstyle\sum_i H_iS_i \ge 205\ \text{MWs} \tag{R7}\\
& 2H_iS_i\,\Delta f_{max}^{lim}/f_0 \le E_i^{res},\;\; 2H_iS_i\,\dot f^{lim}/f_0 \le \Delta P_i^{disp} \tag{R8}\\
& 2{,}2 \le K_i(K_{q,i}\alpha_i+\beta_i) \le 1/(n\tau_q),\;\; \underline\theta \le \theta \le \overline\theta \tag{R9--10}
\end{align}
para toda unidad $u$, GFM $i$, barra $b$ y $t\in[0,T]$. La Tabla~\ref{tab:restr} indica el origen de cada
restricción y la Tabla~\ref{tab:param}, los parámetros.

