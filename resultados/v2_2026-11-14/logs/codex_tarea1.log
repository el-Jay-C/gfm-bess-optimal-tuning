    for s in ['inicial','F1_articulo','opt_R','opt_L'] for lim in [0,1]])
csv('certificados.csv', [dict(sintonia='opt_R', zeta_min=.06, alpha_LMI_comun=.1)])
csv('ablacion.csv', [dict(caso='R_3 & R4', J=.632, dfmax_Hz=.42, viol_P=.001, **th)])
csv('robusto.csv', [dict(sintonia=s, J_S1=.6,J_S2=.7,J_S3=.8,J_max=.8,J_esp=.67) for s in ['opt_R','afin']])
