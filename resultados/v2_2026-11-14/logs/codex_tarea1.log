    contenido += [\" & \".join(fila) + r\" \\\\\" for fila in filas]
    contenido += [r\"\\bottomrule\", r\"\\end{tabular}\"]
    (SAL / archivo).write_text(\"\\n\".join(contenido) + \"\\n\", encoding=\"utf-8\")


